PORT=3000
SESSION_SECRET=cambia-questa-chiave-segreta-lunga-e-casuale
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-questa-password

# Stringa di connessione Postgres (es. Supabase: Project Settings -> Database ->
# Connection string -> usa quella "Connection pooling", modalità Session, porta 5432
# oppure Transaction, porta 6543 - entrambe funzionano, la pooler è più compatibile
# con hosting che non supportano IPv6 come Render).
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
